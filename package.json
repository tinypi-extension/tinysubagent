{
  "name": "tinysubagent",
  "version": "0.3.4",
  "description": "Minimal herdr-native subagent spawning for pi — markdown agent roles, model profiles with classifier routing",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Ironman",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "smoke:tool": "node scripts/smoke-tool.ts",
    "smoke:layout": "node scripts/smoke-layout.ts",
    "smoke-layout": "node scripts/smoke-layout.ts",
    "smoke:interrupt": "node scripts/smoke-interrupt.ts",
    "smoke:provider-error": "node scripts/smoke-provider-error.ts",
    "link-plugin": "herdr plugin link ./herdr-plugin --enabled"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
