{
  "name": "tinysubagent",
  "version": "0.1.0",
  "description": "Minimal herdr-native subagent spawning for pi — markdown agent roles, model profiles, single or parallel panes",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "author": "Ironman",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "smoke:tool": "node scripts/smoke-tool.ts",
    "smoke:interrupt": "node scripts/smoke-interrupt.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^22.10.0",
    "typebox": "^1.3.7",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
